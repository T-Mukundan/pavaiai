# PRAVAH-AI Environment Configuration

# Database: SQLite for local demo or MongoDB/PostgreSQL for production
DATABASE_URL="file:./dev.db"

# 🍃 MongoDB for Text-Based Grievance & Entity Storage
# Example: mongodb+srv://username:password@cluster.mongodb.net/pravah_ai
MONGODB_URI="mongodb://localhost:27017/pravah_ai"
MONGODB_DB_NAME="pravah_ai"

# ⚡ Supabase Storage for Images, Camera Evidence & Media Files
# Found in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="grievance-evidence"

# Security & NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Python AI Service
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_MODE="demo" # "demo" or "real"

# Local Storage Fallback & Map Cartography
STORAGE_PATH="./public/uploads"
MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
PORT=3000
